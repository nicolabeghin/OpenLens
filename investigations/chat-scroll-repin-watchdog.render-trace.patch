diff --git a/OpenLens/Services/RenderTrace.swift b/OpenLens/Services/RenderTrace.swift
new file mode 100644
index 0000000..e0c3ba9
--- /dev/null
+++ b/OpenLens/Services/RenderTrace.swift
@@ -0,0 +1,38 @@
+#if DEBUG
+import Foundation
+
+/// Temporary diagnostic for the scene-update watchdog kill (`0x8BADF00D`) seen on device: the
+/// main thread spent ten seconds inside one SwiftUI update, and the session count (67) rules out
+/// the work being merely expensive. This counts body evaluations per view so a re-render loop
+/// shows up as a number rather than being inferred from a stack.
+///
+/// Off unless the app is launched with `OPENLENS_TRACE_RENDER`. Delete once the loop is found.
+enum RenderTrace {
+    static let isEnabled = ProcessInfo.processInfo.arguments.contains("OPENLENS_TRACE_RENDER")
+
+    private static var counts: [String: Int] = [:]
+    private static var details: [String: String] = [:]
+    private static var windowStart = Date()
+    /// A view redrawing more often than this in one second is not responding to user input.
+    private static let suspiciousRate = 30
+
+    /// Call as the first statement of a `body`. `detail` is evaluated only when something is
+    /// reported, so it can name the inputs worth comparing between iterations.
+    static func record(_ name: String, detail: @autoclosure () -> String = "") {
+        guard isEnabled else { return }
+        counts[name, default: 0] += 1
+        details[name] = detail()
+
+        let now = Date()
+        let elapsed = now.timeIntervalSince(windowStart)
+        guard elapsed >= 1 else { return }
+        let busy = counts.filter { $0.value >= suspiciousRate }.sorted { $0.value > $1.value }
+        for (view, count) in busy {
+            print("[render-trace] \(view) ran \(count)x in \(String(format: "%.1f", elapsed))s — \(details[view] ?? "")")
+        }
+        counts.removeAll()
+        details.removeAll()
+        windowStart = now
+    }
+}
+#endif
